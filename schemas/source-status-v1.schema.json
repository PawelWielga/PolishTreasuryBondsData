{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawelwielga.github.io/PolishTreasuryBondsData/schemas/source-status-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "datasetRevision", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "datasetRevision": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$" },
    "sources": {
      "type": "object",
      "required": ["mf", "gus", "nbp"],
      "properties": {
        "mf": {
          "allOf": [
            { "$ref": "#/$defs/sourceStatus" },
            { "properties": { "staleAfterHours": { "const": 744 } } }
          ]
        },
        "gus": {
          "allOf": [
            { "$ref": "#/$defs/sourceStatus" },
            { "properties": { "staleAfterHours": { "const": 744 } } }
          ]
        },
        "nbp": {
          "allOf": [
            { "$ref": "#/$defs/sourceStatus" },
            { "properties": { "staleAfterHours": { "const": 168 } } }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourceStatus": {
      "type": "object",
      "required": ["status", "lastAttemptAt", "lastAttemptStatus", "lastSuccessAt", "staleAfterHours", "message"],
      "properties": {
        "status": { "enum": ["FRESH", "STALE", "PARTIAL", "UNAVAILABLE"] },
        "lastAttemptAt": { "type": ["string", "null"], "format": "date-time" },
        "lastAttemptStatus": { "enum": ["SUCCESS", "FAILED", "NEVER"] },
        "lastSuccessAt": { "type": ["string", "null"], "format": "date-time" },
        "staleAfterHours": { "type": "integer", "minimum": 1 },
        "message": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["FRESH", "STALE", "PARTIAL"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "lastSuccessAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
