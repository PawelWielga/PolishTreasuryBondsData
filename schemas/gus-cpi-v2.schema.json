{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawelwielga.github.io/PolishTreasuryBondsData/schemas/gus-cpi-v2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "observations"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["period", "indexPreviousYear100", "yearOverYearPercent", "revision", "source"],
        "properties": {
          "period": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
          "indexPreviousYear100": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2,4}$" },
          "yearOverYearPercent": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2,4}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "source": {
            "type": "object",
            "required": ["publisher", "api", "year", "periodId"],
            "properties": {
              "publisher": { "const": "GUS" },
              "api": { "const": "SDP" },
              "year": { "type": "integer", "minimum": 2000 },
              "periodId": { "type": "integer", "minimum": 247, "maximum": 258 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
