{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawelwielga.github.io/PolishTreasuryBondsData/schemas/snapshot-manifest-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "datasetRevision", "generatedAt", "files", "provenance", "coverage"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "datasetRevision": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "object",
      "required": ["catalog.json", "product-definitions.json", "gus-cpi.json", "nbp-reference-rates.json"],
      "properties": {
        "catalog.json": {
          "allOf": [
            { "$ref": "#/$defs/fileEntry" },
            { "properties": { "path": { "const": "catalog.json" } } }
          ]
        },
        "product-definitions.json": {
          "allOf": [
            { "$ref": "#/$defs/fileEntry" },
            { "properties": { "path": { "const": "product-definitions.json" } } }
          ]
        },
        "gus-cpi.json": {
          "allOf": [
            { "$ref": "#/$defs/fileEntry" },
            { "properties": { "path": { "const": "gus-cpi.json" } } }
          ]
        },
        "nbp-reference-rates.json": {
          "allOf": [
            { "$ref": "#/$defs/fileEntry" },
            { "properties": { "path": { "const": "nbp-reference-rates.json" } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["mf", "gus", "nbp"],
      "properties": {
        "mf": { "$ref": "#/$defs/mfProvenance" },
        "gus": { "$ref": "#/$defs/gusProvenance" },
        "nbp": { "$ref": "#/$defs/nbpProvenance" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["catalog", "gusCpi", "nbpReferenceRates"],
      "properties": {
        "catalog": {
          "type": "object",
          "required": ["OTS", "ROR", "DOR", "TOS", "COI", "EDO", "ROS", "ROD"],
          "properties": {
            "OTS": { "$ref": "#/$defs/catalogCoverage" },
            "ROR": { "$ref": "#/$defs/catalogCoverage" },
            "DOR": { "$ref": "#/$defs/catalogCoverage" },
            "TOS": { "$ref": "#/$defs/catalogCoverage" },
            "COI": { "$ref": "#/$defs/catalogCoverage" },
            "EDO": { "$ref": "#/$defs/catalogCoverage" },
            "ROS": { "$ref": "#/$defs/catalogCoverage" },
            "ROD": { "$ref": "#/$defs/catalogCoverage" }
          },
          "additionalProperties": false
        },
        "gusCpi": { "$ref": "#/$defs/gusCoverage" },
        "nbpReferenceRates": { "$ref": "#/$defs/nbpCoverage" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fileEntry": {
      "type": "object",
      "required": ["path", "sha256", "schemaVersion", "count"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schemaVersion": { "const": "2.0" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mfProvenance": {
      "type": "object",
      "required": ["publisher", "url", "sha256", "verifiedAt"],
      "properties": {
        "publisher": { "const": "Ministry of Finance" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://www\\.gov\\.pl/attachment/[^?#]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verifiedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "gusProvenance": {
      "type": "object",
      "required": ["publisher", "api", "baseUrl", "verifiedAt"],
      "properties": {
        "publisher": { "const": "GUS" },
        "api": { "const": "SDP" },
        "baseUrl": { "const": "https://api-sdp.stat.gov.pl/api/1.1.0" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "nbpProvenance": {
      "type": "object",
      "required": ["publisher", "url", "verifiedAt"],
      "properties": {
        "publisher": { "const": "NBP" },
        "url": { "const": "https://static.nbp.pl/dane/stopy/stopy_procentowe_archiwum.xml" },
        "currentUrl": { "const": "https://static.nbp.pl/dane/stopy/stopy_procentowe.xml" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "catalogCoverage": {
      "type": "object",
      "required": ["firstSaleFrom", "lastSaleTo", "seriesCount", "termsRevisionCount", "gaps"],
      "properties": {
        "firstSaleFrom": { "type": "string", "format": "date" },
        "lastSaleTo": { "type": "string", "format": "date" },
        "seriesCount": { "type": "integer", "minimum": 1 },
        "termsRevisionCount": { "type": "integer", "minimum": 1 },
        "gaps": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "gusCoverage": {
      "type": "object",
      "required": ["fromPeriod", "throughPeriod", "observationCount"],
      "properties": {
        "fromPeriod": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "throughPeriod": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "observationCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "nbpCoverage": {
      "type": "object",
      "required": ["fromEffectiveDate", "throughEffectiveDate", "observationCount"],
      "properties": {
        "fromEffectiveDate": { "type": "string", "format": "date" },
        "throughEffectiveDate": { "type": "string", "format": "date" },
        "observationCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
