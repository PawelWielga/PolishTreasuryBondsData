{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawelwielga.github.io/PolishTreasuryBondsData/schemas/early-redemption-rules-v2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "rules"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "rule": {
      "type": "object",
      "required": [
        "productType",
        "rulesRevision",
        "purchaseFrom",
        "purchaseThrough",
        "minimumHoldingCalendarDays",
        "latestInstruction",
        "paymentTiming",
        "interestAccrualTiming",
        "excludedInstructionDates",
        "chargeMinorUnits",
        "chargeApplication",
        "provenance"
      ],
      "properties": {
        "productType": {
          "enum": ["OTS", "ROR", "DOR", "TOS", "COI", "EDO", "ROS", "ROD"]
        },
        "rulesRevision": {
          "type": "integer",
          "minimum": 1
        },
        "purchaseFrom": {
          "type": "string",
          "format": "date"
        },
        "purchaseThrough": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "minimumHoldingCalendarDays": {
          "type": "integer",
          "minimum": 0
        },
        "latestInstruction": {
          "type": "object",
          "required": ["unit", "value"],
          "properties": {
            "unit": {
              "enum": ["CalendarDaysBeforeMaturity", "CalendarMonthsBeforeMaturity"]
            },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "paymentTiming": {
          "type": "object",
          "required": ["unit", "value"],
          "properties": {
            "unit": { "const": "BusinessDaysAfterInstruction" },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "interestAccrualTiming": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "const": "None" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "ThroughBusinessDayAfterInstruction" },
                "value": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "excludedInstructionDates": {
          "type": "array",
          "items": {
            "enum": ["InterestEntitlementDate"]
          },
          "uniqueItems": true
        },
        "chargeMinorUnits": {
          "type": "integer",
          "minimum": 0
        },
        "chargeApplication": {
          "enum": [
            "NoCharge",
            "DeductUpToAccruedInterest",
            "FirstPeriodDeductUpToAccruedInterestThenFullCharge"
          ]
        },
        "provenance": {
          "type": "object",
          "required": ["publisher", "documentType", "seriesCode", "url", "verifiedAt"],
          "properties": {
            "publisher": { "const": "Ministry of Finance" },
            "documentType": {
              "enum": ["IssuanceLetter", "OfferPage"]
            },
            "seriesCode": {
              "type": "string",
              "pattern": "^[A-Z]{3}[0-9]{4}$"
            },
            "url": { "$ref": "#/$defs/httpsUri" },
            "verifiedAt": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "chargeApplication": { "const": "NoCharge" }
            },
            "required": ["chargeApplication"]
          },
          "then": {
            "properties": {
              "chargeMinorUnits": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "productType": { "const": "OTS" }
            },
            "required": ["productType"]
          },
          "then": {
            "properties": {
              "chargeMinorUnits": { "const": 0 },
              "chargeApplication": { "const": "NoCharge" },
              "interestAccrualTiming": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "const": "None" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
