{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawelwielga.github.io/PolishTreasuryBondsData/schemas/nbp-reference-rates-v2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "observations"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effectiveFrom", "annualRatePercent", "revision", "publishedAt", "source"],
        "properties": {
          "effectiveFrom": { "type": "string", "format": "date" },
          "annualRatePercent": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2,4}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "source": {
            "enum": [
              "https://nbp.pl/podstawowe-stopy-procentowe-archiwum/",
              "https://static.nbp.pl/dane/stopy/stopy_procentowe_archiwum.xml"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
